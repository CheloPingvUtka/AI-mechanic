APP_NAME=Digital Mechanic API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Организаторские Mock API запускаются в отдельном приватном репозитории.
MOCK_ML_BASE_URL=http://127.0.0.1:8001
MOCK_TOIR_BASE_URL=http://127.0.0.1:8002
HTTP_TIMEOUT_SECONDS=10

# Путь к vehicles.json внутри локальной копии приватного репозитория.
# Файл не копируется в этот репозиторий и не коммитится.
VEHICLE_CATALOG_PATH=../private-neurodvs-mock/data/vehicles.json

# RAG: материалы и индекс хранятся вне Git.
KNOWLEDGE_BASE_PATH=../private-knowledge
# OCR страниц-сканов при индексации: tesseract + язык rus. Пусто = системная tessdata.
TESSDATA_DIR=

# LLM: любой OpenAI-совместимый /chat/completions с вызовом инструментов (по умолчанию OpenRouter).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
